# ProofPack Environment Configuration Template

# Service Ports
PORT=4000
VITE_API_URL=http://localhost:4000

# Application Mode: testnet | mainnet | local
APP_MODE=testnet

# ==============================================================================
# TARGET 1: MST Coral Testnet (Official Target Deployment Network)
# ==============================================================================
# Network Name: MST Coral Testnet
# Chain ID (Decimal): 54635 | Chain ID (Hex): 0xd56b
# Native Currency: tMSTC (18 decimals)
# Verified RPC: https://coralrpc.mstblockchain.com
# Verified Explorer: https://coral.mstscan.com (also https://testnet.mstscan.com)
# RPC Node List / Chainlist: https://cryptotools.vip/chainlist/mst-coral-testnet-54635
# Faucet: https://coral-faucet.mstblockchain.com/
MST_NETWORK_NAME=MST Coral Testnet
MST_CHAIN_ID=54635
MST_CHAIN_ID_HEX=0xd56b
MST_CURRENCY_SYMBOL=tMSTC
MST_RPC_URL=https://coralrpc.mstblockchain.com
MST_EXPLORER_URL=https://coral.mstscan.com
MST_EXPLORER_API_URL=https://coral.mstscan.com/api/v2
MST_SETTLEMENT_CONTRACT=0x0000000000000000000000000000000000000000

# ==============================================================================
# TARGET 2: MST Mainnet (Production L1 Reference)
# ==============================================================================
# Chain ID: 4646 (0x1226) | Chainlist: https://chainlist.org/chain/4646
# RPC: https://mariorpc.mstblockchain.com
# Explorer: https://mstscan.com | Tokens Form: https://mstblockchain.com/contact/
# MST_CHAIN_ID=4646
# MST_RPC_URL=https://mariorpc.mstblockchain.com
# MST_EXPLORER_URL=https://mstscan.com
# MST_EXPLORER_API_URL=https://mstscan.com/api/v2

# ==============================================================================
# LEGACY TESTNET DEPRECATION NOTICE:
# Legacy MST Testnet Chain IDs: 91562037 (0x5752035) and 4545
# Status: Deprecated. Scheduled for shutdown on January 31, 2027.
# Do NOT use legacy chain IDs for new deployments. Use Coral Testnet (54635).
# ==============================================================================

# Live Network Streaming vs Synthetic Mock
# Set to 'false' to disable synthetic mock data and sync live on-chain data
ENABLE_MOCK_DATA=false

# Batching Engine Parameters
MAX_BATCH_SIZE=64
MAX_BATCH_WAIT_MS=5000
MIN_BATCH_SIZE=2
MAX_PAYLOAD_BYTES=65536

# Operator Private Key (Used strictly for signing batch settlements on MST L1)
# NOTE: Read-only operations and gasless EIP-712 user transfers do NOT require an operator key.
# Only on-chain batch settlement execution requires an operator key with native gas tokens (tMSTC/MSTC).
# NEVER commit production private keys to version control!
OPERATOR_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Database Configuration (PostgreSQL / In-memory SQLite for development)
DATABASE_URL=postgresql://proofpack:proofpack_dev@localhost:5432/proofpack_db
USE_IN_MEMORY_DB=true

# Log Level: debug | info | warn | error
LOG_LEVEL=info
