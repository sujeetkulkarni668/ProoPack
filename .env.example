# ProofPack Environment Configuration

# Service Ports
PORT=4000
VITE_API_URL=http://localhost:4000

# MST Blockchain Network Configuration
# Supported Chain IDs: 4646 (MST Mainnet), 4545 (MST Testnet), 31337 (Local Devnet)
MST_CHAIN_ID=4545
MST_RPC_URL=https://testnetrpc.mstblockchain.com
MST_EXPLORER_URL=https://mstscan.com
MST_SETTLEMENT_CONTRACT=0x0000000000000000000000000000000000000000

# Batching Engine Parameters
MAX_BATCH_SIZE=64
MAX_BATCH_WAIT_MS=5000
MIN_BATCH_SIZE=2
MAX_PAYLOAD_BYTES=65536

# Operator Private Key (Used strictly for signing batch settlements on MST L1)
# Note: Never commit real production keys! Safe mock key for local testing provided below:
OPERATOR_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Database Configuration (PostgreSQL / SQLite fallback for lightweight development)
DATABASE_URL=postgresql://proofpack:proofpack_dev@localhost:5432/proofpack_db
USE_IN_MEMORY_DB=true

# Log Level: debug | info | warn | error
LOG_LEVEL=info
